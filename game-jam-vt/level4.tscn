@export var UPSPEED: int = 10

# Called when the node enters the scene tree for the first time.
func _ready():
	pass
	
func _process(delta):
	pass


func _on_body_entered(body):
	if body.name == \"Basic FPS Player\":
		body.velocity.y = UPSPEED
"

